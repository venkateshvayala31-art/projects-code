<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1.0">  
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f4f4;
        }

        /* Navbar */
        .navbar {
            background: #333;
            padding: 15px;
            color: white;
            display: flex;
            justify-content: space-between;
        }

        .navbar a {
            color: white;
            text-decoration: none;
            margin-left: 20px;
        }

        /* Hero section */
        .hero {
            background: #0d6efd;
            color: white;
            padding: 80px 20px;
            text-align: center;
        }

        /* Sections */
        .section {
            padding: 40px;
            text-align: center;
            background: white;
            margin: 20px;
            border-radius: 10px;
        }
        /* Footer */
        .footer {
            background: #222;
            color: white;
            text-align: center;
            padding: 15px;
        }
    </style>
</head>

<body>

    <!-- Navbar -->
    <div class="navbar">
        <h2>My Website</h2>
        <div>
            <a href="#">Home</a>
            <a href="#">About</a>
            <a href="#">Services</a>
            <a href="#">Contact</a>
        </div>
    </div>

    <!-- Hero Section -->
    <div class="hero">
        <h1>Welcome to My Website</h1>
        <p>This is a simple website created by HTML & CSS</p>
    </div>

    <!-- About Section -->
    <div class="section">
        <h2>About Me</h2>
        <p>I am learning web development and creating my first website!</p>
    </div>

    <!-- Services -->
    <div class="section">
        <h2>My Services</h2>
        <p>I create websites, designs, and basic projects.</p>
    </div>

    <!-- Footer -->
    <div class="footer">
        <p>© 2025 My Website | All Rights Reserved</p>
    </div>

</body>
</html> 