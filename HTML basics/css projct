body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    background-color: #f01010;
    text-align: center;
}

header {
    background-color: #222;
    color: rgb(16, 0, 0);
    padding: 30px;
}

.about, .contact {
    background: white;
    margin: 20px;
    padding: 20px;
    border-radius: 8px; 
}

.btn {
    display: inline-block;
    background-color: #007bff;
    color: rgb(203, 35, 35);
    padding: 10px 20px;
    text-decoration: none;
    border-radius: 5px;
}

.btn:hover {
    background-color: #0056b3;
}

footer {
    background-color: #222;
    color: white;
    padding: 10px;
}
